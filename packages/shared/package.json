{
  "name": "@vesper/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "default": "./src/queries/index.ts"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "default": "./src/onboarding/index.ts"
    },
    "./subscriptionState": {
      "types": "./dist/subscriptionState.d.ts",
      "default": "./src/subscriptionState.ts"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./src/realtime/index.ts"
    },
    "./copy": {
      "types": "./dist/copy/index.d.ts",
      "default": "./src/copy/index.ts"
    },
    "./nutrition": {
      "types": "./dist/nutrition/index.d.ts",
      "default": "./src/nutrition/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.0",
    "@sentry/nextjs": "^8.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/query-core": "5.100.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vesper/db": "workspace:*",
    "date-fns": "^3.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}

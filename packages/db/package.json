{
  "name": "@vesper/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./encryption": {
      "types": "./dist/encryption.d.ts",
      "default": "./src/encryption.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "setup-test-db": "tsx scripts/setup-test-db.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "libsodium-wrappers": "^0.7.15",
    "postgres": "^3.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}

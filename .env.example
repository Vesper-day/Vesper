# =============================================================================
# Vesper — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* variables are exposed to the browser bundle.
# All others are server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Transaction Pooler URL — used by Drizzle in serverless API routes.
# Format: postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Direct connection URL — used by drizzle-kit for migrations (not pooler).
# Format: postgres://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DIRECT_URL=postgres://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSJ9...
MAPBOX_SECRET_TOKEN=sk.eyJ1IjoieW91ci11c2VybmFtZSJ9...

# -----------------------------------------------------------------------------
# Yelp
# -----------------------------------------------------------------------------
YELP_API_KEY=your-yelp-fusion-api-key

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the Vesper Standard Monthly plan (price_XXXXXXXXXXXXXXXXXXXX)
STRIPE_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------------
# Resend (transactional email / magic links)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# PostHog
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
# Web DSN (also used in Cloudflare Workers)
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Mobile DSN (embedded in Expo build — set in app.config.js)
# SENTRY_MOBILE_DSN=https://your-key@o0.ingest.sentry.io/0

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Minimum supported native client version (x.y.z). Native clients sending an
# X-App-Version below this receive 426 Upgrade Required. Defaults to 1.0.0 if unset.
MIN_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Mobile (Expo) — set in apps/mobile/.env.local
# Expo uses EXPO_PUBLIC_ prefix (equivalent of NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# -----------------------------------------------------------------------------
# Cloudflare Workers (set via `wrangler secret put` — never in .env.local)
# These are documented here for reference only.
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ANTHROPIC_API_KEY=sk-ant-api03-...
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# Vesper — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* variables are exposed to the browser bundle.
# All others are server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Transaction Pooler URL — used by Drizzle in serverless API routes.
# Format: postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Direct connection URL — used by drizzle-kit for migrations (not pooler).
# Format: postgres://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DIRECT_URL=postgres://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSJ9...
MAPBOX_SECRET_TOKEN=sk.eyJ1IjoieW91ci11c2VybmFtZSJ9...

# -----------------------------------------------------------------------------
# Yelp
# -----------------------------------------------------------------------------
YELP_API_KEY=your-yelp-fusion-api-key

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the Vesper Standard Monthly plan (price_XXXXXXXXXXXXXXXXXXXX)
STRIPE_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# Internal auth-event endpoint (chat 030)
# -----------------------------------------------------------------------------
# Shared secret guarding POST /api/v1/internal/auth-event. The same value must be
# stored in Supabase Vault as `auth_event_secret` (with `auth_event_base_url`) so
# the auth.users UPDATE trigger (migration 20260601000023) can authenticate to the
# endpoint. The endpoint fails closed if this is unset.
AUTH_EVENT_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------------
# Resend (transactional email / magic links)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting — ARCHITECTURE_DECISIONS Decision 14)
# Server-only. Read by @upstash/redis Redis.fromEnv() in rateLimit.ts and the
# Vercel Edge middleware. See packages/shared/RATE_LIMITING.md.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# PostHog
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
# Web DSN (also used in Cloudflare Workers)
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Public DSN for the browser bundle (web client SDK). Usually the same value.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Source-map upload (CI/Cutover only). When unset, withSentryConfig disables
# upload and the build still succeeds. org/project pair the token.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=vesper-web
# Mobile DSN (embedded in Expo build — set in app.config.js)
# SENTRY_MOBILE_DSN=https://your-key@o0.ingest.sentry.io/0

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Minimum supported native client version (x.y.z). Native clients sending an
# X-App-Version below this receive 426 Upgrade Required. Defaults to 1.0.0 if unset.
MIN_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Mobile (Expo) — set in apps/mobile/.env.local
# Expo uses EXPO_PUBLIC_ prefix (equivalent of NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Mobile Sentry DSN (embedded in the Expo bundle). Unset = Sentry.init no-ops.
# EXPO_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Mobile auth observability (optional; both unset = PostHog capture no-ops)
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Cloudflare Workers (set via `wrangler secret put` — never in .env.local)
# These are documented here for reference only.
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ANTHROPIC_API_KEY=sk-ant-api03-...
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# -----------------------------------------------------------------------------
# Google Sign-In (Supabase Auth login provider — see supabase/config.toml)
# -----------------------------------------------------------------------------
# OAuth client for "Sign in with Google" app login. DISTINCT from the Calendar
# integration client below. Referenced by supabase/config.toml.
GOOGLE_CLIENT_ID=your-google-signin-client-id
GOOGLE_CLIENT_SECRET=your-google-signin-client-secret

# -----------------------------------------------------------------------------
# Google Calendar OAuth + token encryption (chat 063)
# -----------------------------------------------------------------------------
# SEPARATE OAuth 2.0 client (scope calendar.readonly) from Google Cloud Console,
# distinct from the Sign-In client above. The connect route exchanges the
# authorization code at https://oauth2.googleapis.com/token using these.
# Registered redirect URI: http://localhost:3000/settings/integrations/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-calendar-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-calendar-oauth-client-secret
# Public half of the Calendar OAuth client id, exposed to the browser so the
# settings page builds the Google consent URL. Same value as
# GOOGLE_OAUTH_CLIENT_ID (a Google client id is not secret; the SECRET stays
# server-only, used only inside the connect route's token exchange).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-calendar-oauth-client-id
# App-side encryption key for the integrations OAuth token columns
# (access_token_encrypted / refresh_token_encrypted). Base64-encoded 32 bytes
# (libsodium XChaCha20-Poly1305). Held in the server env, NEVER in the database
# (TECHNICAL_SPEC §13). Generate with: openssl rand -base64 32
# Rotation procedure: docs/RUNBOOKS/PGSODIUM_KEY_ROTATION.md
PGSODIUM_KEY=base64-encoded-32-byte-key
# Google Calendar push-webhook channel token (chat 065). Opaque secret set on the
# events.watch channel and echoed back by Google in the X-Goog-Channel-Token header
# of every push; the /webhooks/google-calendar receiver validates it (constant-time)
# and 401s a mismatch. A single DEPLOYMENT secret (not a per-channel DB value —
# channel-state persistence is deferred to 066/Cutover). Generate with: openssl rand -hex 32
GOOGLE_WEBHOOK_CHANNEL_TOKEN=your-google-webhook-channel-token

# -----------------------------------------------------------------------------
# Template seed sourcing (build-time only — packages/db/seed/scripts)
# RapidAPI key for ExerciseDB (buildWorkoutTemplates.ts). TheMealDB needs no key.
# -----------------------------------------------------------------------------
RAPIDAPI_KEY=your-rapidapi-key

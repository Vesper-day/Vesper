# Environment — gitignore at every level
.env.local
**/.env.local
.env.*.local
**/.env.*.local
.env

# pnpm
node_modules
.pnpm-store

# Turbo
.turbo

# Next.js
apps/web/.next
apps/web/out

# Expo / React Native
apps/mobile/.expo
apps/mobile/dist
apps/mobile/ios/build
apps/mobile/ios/Pods
apps/mobile/ios/DerivedData

# Build outputs
dist
build

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sentry
.sentryclirc

# Playwright
apps/web/playwright-report/
apps/web/test-results/

# Misc
.vercel

# Supabase CLI local cache
supabase/.branches/
supabase/.temp/
supabase/snippets/

# Remotion marketing experiments (local only)
remotion/

# Stray nested Claude config (real config lives at repo root)
docs/.claude/.claude/settings.local.json 

# Landing manor 3D build (093-V Path B) — raw render frames are huge, keep local only.
# The .blend source and BUILD_STATE.md ARE tracked; only the frame dumps are ignored.
art/landing-manor/frames/
art/landing-manor/**/*.blend1

# --- Publication hardening: never commit credential-bearing or machine-local files ---
.env
.env.*
env.local
!.env.example
*.bak
*.old
*.save
*~
*.swp
*.p8
*.p12
*.pem
*.key
*.keystore
*.jks
*.mobileprovision
id_rsa*
.npmrc
.netrc
eas.json
GoogleService-Info.plist
google-services.json
ExportOptions.plist
serviceAccount*.json
.DS_Store
Thumbs.db
*.log
coverage/
.next/
.expo/
out/

